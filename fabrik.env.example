# fabrik-Config (Kopie nach fabrik.env — wird via `fabrik env` geladen)
#
# LLM-Provider: mehrere OpenAI-kompatible Endpunkte, in der UI umschaltbar.
#   Named-Provider: FABRIK_LLM_PROVIDERS=llama-cpp[,ollama]
#     FABRIK_LLM_LLAMA_CPP_URL=https://<llama.cpp-Server>/v1/chat/completions
#     FABRIK_LLM_LLAMA_CPP_MODEL=Qwen3.8-27B-GGUF
#     # Optionaler lokaler Ollama-Provider (kleines Modell, nur als Fallback):
#     # FABRIK_LLM_OLLAMA_URL=http://127.0.0.1:11434/v1/chat/completions
#     # FABRIK_LLM_OLLAMA_MODEL=llama3.2:3b
#     # Optionaler remote Hetzner-Inference-Provider (Qwen3.8-27B):
#     # FABRIK_LLM_HETZNER_URL=https://inference.hetzner.com/api/v1/chat/completions
#     # FABRIK_LLM_HETZNER_MODEL=Qwen3.8-27B
#     # FABRIK_LLM_HETZNER_KEY=<Hetzner-API-Token>
#   CLI-Provider (_CLI statt _URL, Auth = CLI-Login): claude | copilot
#     # FABRIK_LLM_CLAUDE_CLI=claude
#     # FABRIK_LLM_CLAUDE_MODEL=claude-sonnet-5-5
#     # FABRIK_LLM_COPILOT_CLI=copilot
#     # FABRIK_LLM_COPILOT_MODEL=gpt-5.6-luna
#   Legacy (ein Endpunkt, wird Provider 'default'):
FABRIK_LLM_URL=https://<llama.cpp-Server>/v1/chat/completions
FABRIK_LLM_MODEL=Qwen3.8-27B-GGUF
# FABRIK_LLM_KEY=
# Aktiver Provider: state/active_llm (per UI-Select / POST /api/llm gesetzt).

# GitHub — Dual-Identity (ADR 0010):
#   Builder = GitHub-App (erstellt/mergt PRs), Reviewer = zweite GitHub-App
#   (approvet PRs). GitHub verbietet Self-Approval → zwei Identitäten.
# GITHUB_TOKEN: App-Installation-Token, 1h gültig — NICHT hier setzen
# (fabrik.env wird nur beim Start geladen → Token würde stale werden).
# Stattdessen: scripts/gh-token-refresh.py (Cron */30) schreibt es in
# FABRIK_ENV_FILE (Default ~/.config/fabrik/fabrik.env), das pro API-Call neu gelesen wird.
#   BUILDER_APP_ID=<Client-ID (Iv23…, empfohlen) oder App-ID>
#   BUILDER_APP_KEY_FILE=/pfad/zu/app-private-key.pem
#   BUILDER_INSTALLATION_ID=<Installation-ID>
# Reviewer als zweite App statt PAT (z. B. my-reviewer-app): Token per
# `scripts/gh-token-refresh.py --role reviewer` (Cron */30) → GITHUB_REVIEWER_TOKEN.
#   REVIEWER_APP_ID=<Client-ID oder App-ID>
#   REVIEWER_APP_KEY_FILE=/pfad/zu/qa-app-private-key.pem
#   REVIEWER_INSTALLATION_ID=<Installation-ID>
# GITHUB_REVIEWER_TOKEN: Installation-Token der Reviewer-App (1h gültig).
# App braucht: Contents:read + Pull requests:read/write am Ziel-Repo.
# GITHUB_REVIEWER_TOKEN=

# Agent-Backend (P1): opencode serve als Worker-Backend (1.x und 2.x,
# Version wird automatisch erkannt — ADR 0005)
#   opencode serve --hostname 127.0.0.1   (Default-Port 4096)
#   Model-Format: provider/model — Provider-Name wie in der opencode-Config
#   (~/.config/opencode/opencode.jsonc), z.B. llama/Qwen3.8-27B-GGUF
FABRIK_AGENT_BACKEND=opencode
FABRIK_AGENT_ENDPOINT=http://127.0.0.1:4096
FABRIK_AGENT_MODEL=llama/Qwen3.8-27B-GGUF
# Session-Inaktivitaets-Schwelle (s): CPU-Boxen brauchen mehr (Prompt-Processing
# fuer das erste Token), GPU-Servers koennen kuerzer. Default 900.
# FABRIK_AGENT_STALE_AFTER=900
# opencode 2.x: HTTP-Basic-Auth am serve-Prozess (gleicher Wert wie
# OPENCODE_SERVER_PASSWORD beim Server-Start; 1.x braucht kein Passwort).
# FABRIK_AGENT_PASSWORD=
# FABRIK_AGENT_USERNAME=opencode
#
# Agent-Backend 'copilot' (GitHub Copilot CLI, One-Shot `copilot -p`):
#   FABRIK_AGENT_BACKEND=copilot
#   Model optional (CLI-Default), z.B. FABRIK_AGENT_MODEL=gpt-5.3-codex
#   Tools-Override (Default --allow-all-tools): FABRIK_COPILOT_TOOLS=shell,write
#   Auth: COPILOT_GITHUB_TOKEN / GH_TOKEN / GITHUB_TOKEN (fine-grained PAT,
#   "Copilot Requests") — in der Deployment-Umgebung setzen, nicht hier committen.
# FABRIK_COPILOT_TOOLS=
#
# Agent-Env-Allowlist (ADR 0050): Agent-Prozesse erben kein os.environ.
# Zusätzliche (nicht sensible) Env-Namen, die Agent-Prozesse erhalten (kommagetrennt):
# FABRIK_AGENT_ENV_EXTRA=
#
# Egress default-deny (ADR 0051): Agent-Internetzugang nur über den Allowlist-Proxy.
# `fabrik egress start|stop|status`. Port/Proxy-Image/erlaubte Domänen:
# FABRIK_EGRESS_PORT=8899
# FABRIK_EGRESS_IMAGE=            # Default: vimagick/tinyproxy per Digest gepinnt (tinyproxy 1.11.0)
# FABRIK_EGRESS_ALLOWLIST=example.org      # kommasetrennt, ergänzt die Datei + Builtins
# FABRIK_EGRESS_ALLOWLIST_FILE=deploy/egress-allowlist.txt   # optional, keine Voreinstellung; Einträge werden validiert
# Gepinnte Subnets der Proxy-Netzwerke (die gerenderten Allow-Zeilen nutzen genau diese Werte)
# FABRIK_EGRESS_SUBNET=172.27.0.0/16
# FABRIK_SANDBOX_SUBNET=172.28.0.0/16
#
# Per-Run-Agent-Sandbox (ADR 0054, in Überarbeitung): Jeder One-Shot-CLI-Agent-Run im Docker-Container
# (cap-drop ALL, no-new-privileges, Resource-Caps, read-only root fs, kein Worktree-Mount:
# Austausch per git-Bundle). Das Image braucht die Agent-CLI und git.
# FABRIK_SANDBOX=0
# FABRIK_SANDBOX_IMAGE=fabrik/agent-sandbox:latest
# FABRIK_SANDBOX_MEMORY=4g
# FABRIK_SANDBOX_CPUS=2
# FABRIK_SANDBOX_PIDS_LIMIT=512
# FABRIK_SANDBOX_USER=                       # leer = host uid:gid (als root: 10001:10001)
# FABRIK_SANDBOX_NETWORK=fabrik-sandbox      # ADR 0051: internal, kein direkter Egress
# FABRIK_SANDBOX_WORK_SIZE=2g                # tmpfs für den Arbeitsklon (zählt gegen MEMORY)
# FABRIK_EGRESS_PROXY_URL=                   # Default: http://fabrik-egress-proxy:8888 (von `fabrik egress start`)

# Dead-Man's-Switch: Runs in 'running' älter als Xh → error + Alert
# FABRIK_STALE_HOURS=6

# Run-Store (ADR 0034; README „Run-Store“): sql (Default) | json. Bestand: `fabrik migrate-runs`.
# FABRIK_RUN_STORE=sql
# SQL-Store: SQLAlchemy-URL; Default sqlite:///<FABRIK_HOME>/state/fabrik.db
# FABRIK_DB_URL=

# Worker-Pool: max. parallele Runs (Trigger). Lokal/Initial-Test: 1 → alle
# Runs seriell auf einem einzigen Agent-Worker (keine parallelen LLM-Sessions).
# FABRIK_WORKERS=1
# Sprache der Server-Meldungen (Run-Log, Approval-Kontext): de (Default) | en
# FABRIK_LANG=de

# Spec-Quellen (ADR 0047; README „Spec-Quellen“). FABRIK_PROJECTS_PATH: zusätzliche Spec-Ordner
# bzw. Repos mit .fabrik/fabrik.yaml, doppelpunkt-getrennt. FABRIK_DATA: eigene Specs/Templates
# unter $FABRIK_DATA/projects|templates (Default: FABRIK_HOME).
# FABRIK_PROJECTS_PATH=/srv/fabrik/projects:/home/me/src/app

# Run-Worktrees (ADR 0028, Ort: ADR 0047 Nachtrag). Default
# $XDG_STATE_HOME/fabrik/worktrees/<installation> (~/.local/state/…) — außerhalb des
# Checkouts, damit IDEs/Indexer sie nicht sehen. Bei flüchtigem $HOME auf ein Volume legen.
# FABRIK_WORKTREES=/srv/fabrik/worktrees

# SonarQube (Loop `sonar-scan`, scripts/sonar-scan.sh): Admin-Credentials für
# Readiness-Check + Token-Generierung (nur relevant, wenn noch kein Token
# gecacht ist). Token wird gecacht in state/sonar-token.txt.
# SONAR_HOST_URL=http://127.0.0.1:9000
# SONAR_ADMIN_USER=admin
# SONAR_ADMIN_PASSWORD=
# SONAR_TOKEN_FILE=
# Branch-/PR-Analyse + GitHub-PR-Dekoration (docs/sonarqube.md):
# SONAR_BRANCH=auto
# SONAR_PR=auto
# SONAR_GH_APP_ID=
# SONAR_GH_CLIENT_ID=
# SONAR_GH_CLIENT_SECRET=
# SONAR_GH_PRIVATE_KEY=state/sonar-github-app.pem

# Auth (ADR 0030): none (Default, nur Loopback) | local (Benutzer + Rollen: `fabrik user add`)
# FABRIK_AUTH=local
# FABRIK_SESSION_TTL=28800
# FABRIK_COOKIE_SECURE=1   # hinter TLS-Reverse-Proxy
# FABRIK_HOST=127.0.0.1
# OIDC (ADR 0046; `pip install 'fabrik[oidc]'`): FABRIK_AUTH=oidc
# FABRIK_OIDC_ISSUER=https://idp.example.com/realms/fabrik
# FABRIK_OIDC_CLIENT_ID=fabrik
# FABRIK_OIDC_CLIENT_SECRET=
# FABRIK_OIDC_REDIRECT_URI=https://fabrik.example.com/api/oidc/callback
# FABRIK_OIDC_ROLE_MAP=fabrik-admins=admin,fabrik-ops=operator,fabrik-view=viewer
# FABRIK_OIDC_GROUPS_CLAIM=groups   # Cognito: cognito:groups
# FABRIK_OIDC_SCOPES="openid profile email"

