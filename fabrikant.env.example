# fabrikant config (copy to fabrikant.env — loaded via `fabrikant env`)
#
# LLM providers: several OpenAI-compatible endpoints, switchable in the UI.
#   Named providers: FABRIKANT_LLM_PROVIDERS=llama-cpp[,ollama]
#     FABRIKANT_LLM_LLAMA_CPP_URL=https://<llama.cpp-server>/v1/chat/completions
#     FABRIKANT_LLM_LLAMA_CPP_MODEL=Qwen3.8-27B-GGUF
#     # Optional local Ollama provider (small model, fallback only):
#     # FABRIKANT_LLM_OLLAMA_URL=http://127.0.0.1:11434/v1/chat/completions
#     # FABRIKANT_LLM_OLLAMA_MODEL=llama3.2:3b
#     # Optional hosted OpenAI-compatible provider:
#     # FABRIKANT_LLM_HOSTED_URL=https://inference.example.com/v1/chat/completions
#     # FABRIKANT_LLM_HOSTED_MODEL=<model>
#     # FABRIKANT_LLM_HOSTED_KEY=<api-token>
#   CLI providers (_CLI instead of _URL, auth = CLI login): claude | copilot
#     # FABRIKANT_LLM_CLAUDE_CLI=claude
#     # FABRIKANT_LLM_CLAUDE_MODEL=claude-sonnet-5-5
#     # FABRIKANT_LLM_COPILOT_CLI=copilot
#     # FABRIKANT_LLM_COPILOT_MODEL=gpt-5.6-luna
#   Legacy (single endpoint, becomes provider 'default'):
FABRIKANT_LLM_URL=https://<llama.cpp-server>/v1/chat/completions
FABRIKANT_LLM_MODEL=Qwen3.8-27B-GGUF
# FABRIKANT_LLM_KEY=
# Active provider: state/active_llm (set via the UI select / POST /api/llm).

# GitHub — dual identity (ADR 0010):
#   Builder = GitHub App (creates/merges PRs), reviewer = second GitHub App
#   (approves PRs). GitHub forbids self-approval → two identities.
# GITHUB_TOKEN: app installation token, valid 1h — do NOT set it here
# (fabrikant.env is only loaded at startup → the token would go stale).
# Instead: scripts/gh-token-refresh.py (cron */30) writes it to
# FABRIKANT_ENV_FILE (default ~/.config/fabrikant/fabrikant.env), which is re-read on every API call.
#   BUILDER_APP_ID=<client ID (Iv23…, recommended) or app ID>
#   BUILDER_APP_KEY_FILE=/path/to/app-private-key.pem
#   BUILDER_INSTALLATION_ID=<installation ID>
# Reviewer as a second app instead of a PAT (e.g. my-reviewer-app): token via
# `scripts/gh-token-refresh.py --role reviewer` (cron */30) → GITHUB_REVIEWER_TOKEN.
#   REVIEWER_APP_ID=<client ID or app ID>
#   REVIEWER_APP_KEY_FILE=/path/to/qa-app-private-key.pem
#   REVIEWER_INSTALLATION_ID=<installation ID>
# GITHUB_REVIEWER_TOKEN: installation token of the reviewer app (valid 1h).
# The app needs: Contents:read + Pull requests:read/write on the target repo.
# GITHUB_REVIEWER_TOKEN=

# Agent backend (P1): opencode serve as worker backend (1.x and 2.x,
# version is detected automatically — ADR 0005)
#   opencode serve --hostname 127.0.0.1   (default port 4096)
#   Model format: provider/model — provider name as in the opencode config
#   (~/.config/opencode/opencode.jsonc), e.g. llama/Qwen3.8-27B-GGUF
FABRIKANT_AGENT_BACKEND=opencode
FABRIKANT_AGENT_ENDPOINT=http://127.0.0.1:4096
FABRIKANT_AGENT_MODEL=llama/Qwen3.8-27B-GGUF
# Session inactivity threshold (s): CPU boxes need more (prompt processing
# for the first token), GPU servers can use less. Default 900.
# FABRIKANT_AGENT_STALE_AFTER=900
# opencode 2.x: HTTP basic auth on the serve process (same value as
# OPENCODE_SERVER_PASSWORD at server start; 1.x needs no password).
# FABRIKANT_AGENT_PASSWORD=
# FABRIKANT_AGENT_USERNAME=opencode
#
# Agent-Backend 'copilot' (GitHub Copilot CLI, One-Shot `copilot -p`):
#   FABRIKANT_AGENT_BACKEND=copilot
#   Model optional (CLI default), e.g. FABRIKANT_AGENT_MODEL=gpt-5.3-codex
#   Tools override (default --allow-all-tools): FABRIKANT_COPILOT_TOOLS=shell,write
#   Auth: COPILOT_GITHUB_TOKEN / GH_TOKEN / GITHUB_TOKEN (fine-grained PAT,
#   "Copilot Requests") — set in the deployment environment, do not commit here.
# FABRIKANT_COPILOT_TOOLS=
#
# Agent env allowlist (ADR 0050): agent processes do not inherit os.environ.
# Additional (non-sensitive) env names that agent processes receive (comma-separated):
# FABRIKANT_AGENT_ENV_EXTRA=
#
# Egress default-deny (ADR 0051): agent internet access only through the allowlist proxy.
# `fabrikant egress start|stop|status`. Port/proxy image/allowed domains:
# FABRIKANT_EGRESS_PORT=8899
# FABRIKANT_EGRESS_IMAGE=            # default: vimagick/tinyproxy pinned by digest (tinyproxy 1.11.0)
# FABRIKANT_EGRESS_ALLOWLIST=example.org      # comma-separated, supplements the file + builtins
# FABRIKANT_EGRESS_ALLOWLIST_FILE=deploy/egress-allowlist.txt   # optional, no default; entries are validated
# Pinned subnets of the proxy networks (the rendered allow lines use exactly these values)
# FABRIKANT_EGRESS_SUBNET=172.27.0.0/16
# FABRIKANT_SANDBOX_SUBNET=172.28.0.0/16
#
# Per-run agent sandbox (ADR 0054, under revision): every one-shot CLI agent run in a Docker container
# (cap-drop ALL, no-new-privileges, resource caps, read-only root fs, no worktree mount:
# exchange via git bundle). The image needs the agent CLI and git.
# FABRIKANT_SANDBOX=0
# FABRIKANT_SANDBOX_IMAGE=fabrikant/agent-sandbox:latest
# FABRIKANT_SANDBOX_MEMORY=4g
# FABRIKANT_SANDBOX_CPUS=2
# FABRIKANT_SANDBOX_PIDS_LIMIT=512
# FABRIKANT_SANDBOX_USER=                       # empty = host uid:gid (as root: 10001:10001)
# FABRIKANT_SANDBOX_NETWORK=fabrikant-sandbox      # ADR 0051: internal, no direct egress
# FABRIKANT_SANDBOX_WORK_SIZE=2g                # tmpfs for the working clone (counts against MEMORY)
# FABRIKANT_EGRESS_PROXY_URL=                   # default: http://fabrikant-egress-proxy:8888 (from `fabrikant egress start`)

# Dead man's switch: runs in 'running' older than X h → error + alert
# FABRIKANT_STALE_HOURS=6

# Run store (ADR 0034; README "Run store"): sql (default) | json. Existing data: `fabrikant migrate-runs`.
# FABRIKANT_RUN_STORE=sql
# SQL store: SQLAlchemy URL; default sqlite:///<FABRIKANT_HOME>/state/fabrikant.db
# FABRIKANT_DB_URL=

# Worker pool: max. parallel runs (triggers). Local/initial test: 1 → all
# runs serial on a single agent worker (no parallel LLM sessions).
# FABRIKANT_WORKERS=1
# Language of server messages (run log, approval context): en (default) | de
# FABRIKANT_LANG=en

# Spec sources (ADR 0047; README "Spec sources"). FABRIKANT_PROJECTS_PATH: additional spec folders
# or repos with .fabrikant/fabrikant.yaml, colon-separated. FABRIKANT_DATA: your own specs/templates
# under $FABRIKANT_DATA/projects|templates (default: FABRIKANT_HOME).
# FABRIKANT_PROJECTS_PATH=/srv/fabrikant/projects:/home/me/src/app

# Run worktrees (ADR 0028, location: ADR 0047 addendum). Default
# $XDG_STATE_HOME/fabrikant/worktrees/<installation> (~/.local/state/…) — outside the
# checkout so IDEs/indexers do not see them. With an ephemeral $HOME, put them on a volume.
# FABRIKANT_WORKTREES=/srv/fabrikant/worktrees

# SonarQube (loop `sonar-scan`, scripts/sonar-scan.sh): admin credentials for
# readiness check + token generation (only relevant if no token is
# cached yet). The token is cached in state/sonar-token.txt.
# SONAR_HOST_URL=http://127.0.0.1:9000
# SONAR_ADMIN_USER=admin
# SONAR_ADMIN_PASSWORD=
# SONAR_TOKEN_FILE=
# Branch/PR analysis + GitHub PR decoration (docs/sonarqube.md):
# SONAR_BRANCH=auto
# SONAR_PR=auto
# SONAR_GH_APP_ID=
# SONAR_GH_CLIENT_ID=
# SONAR_GH_CLIENT_SECRET=
# SONAR_GH_PRIVATE_KEY=state/sonar-github-app.pem

# Auth (ADR 0030): none (default, loopback only) | local (users + roles: `fabrikant user add`)
# FABRIKANT_AUTH=local
# FABRIKANT_SESSION_TTL=28800
# FABRIKANT_COOKIE_SECURE=1   # behind a TLS reverse proxy
# FABRIKANT_HOST=127.0.0.1
# OIDC (ADR 0046; `pip install 'fabrikant[oidc]'`): FABRIKANT_AUTH=oidc
# FABRIKANT_OIDC_ISSUER=https://idp.example.com/realms/fabrikant
# FABRIKANT_OIDC_CLIENT_ID=fabrikant
# FABRIKANT_OIDC_CLIENT_SECRET=
# FABRIKANT_OIDC_REDIRECT_URI=https://fabrikant.example.com/api/oidc/callback
# FABRIKANT_OIDC_ROLE_MAP=fabrikant-admins=admin,fabrikant-ops=operator,fabrikant-view=viewer
# FABRIKANT_OIDC_GROUPS_CLAIM=groups   # Cognito: cognito:groups
# FABRIKANT_OIDC_SCOPES="openid profile email"

