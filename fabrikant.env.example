# fabrikant-Config (Kopie nach fabrikant.env — wird via `fabrikant env` geladen)
#
# LLM-Provider: mehrere OpenAI-kompatible Endpunkte, in der UI umschaltbar.
#   Named-Provider: FABRIKANT_LLM_PROVIDERS=llama-cpp[,ollama]
#     FABRIKANT_LLM_LLAMA_CPP_URL=https://<llama.cpp-Server>/v1/chat/completions
#     FABRIKANT_LLM_LLAMA_CPP_MODEL=Qwen3.8-27B-GGUF
#     # Optionaler lokaler Ollama-Provider (kleines Modell, nur als Fallback):
#     # FABRIKANT_LLM_OLLAMA_URL=http://127.0.0.1:11434/v1/chat/completions
#     # FABRIKANT_LLM_OLLAMA_MODEL=llama3.2:3b
#     # Optional hosted OpenAI-compatible provider:
#     # FABRIKANT_LLM_HOSTED_URL=https://inference.example.com/v1/chat/completions
#     # FABRIKANT_LLM_HOSTED_MODEL=<model>
#     # FABRIKANT_LLM_HOSTED_KEY=<api-token>
#   CLI-Provider (_CLI statt _URL, Auth = CLI-Login): claude | copilot
#     # FABRIKANT_LLM_CLAUDE_CLI=claude
#     # FABRIKANT_LLM_CLAUDE_MODEL=claude-sonnet-5-5
#     # FABRIKANT_LLM_COPILOT_CLI=copilot
#     # FABRIKANT_LLM_COPILOT_MODEL=gpt-5.6-luna
#   Legacy (ein Endpunkt, wird Provider 'default'):
FABRIKANT_LLM_URL=https://<llama.cpp-Server>/v1/chat/completions
FABRIKANT_LLM_MODEL=Qwen3.8-27B-GGUF
# FABRIKANT_LLM_KEY=
# Aktiver Provider: state/active_llm (per UI-Select / POST /api/llm gesetzt).

# GitHub — Dual-Identity (ADR 0010):
#   Builder = GitHub-App (erstellt/mergt PRs), Reviewer = zweite GitHub-App
#   (approvet PRs). GitHub verbietet Self-Approval → zwei Identitäten.
# GITHUB_TOKEN: App-Installation-Token, 1h gültig — NICHT hier setzen
# (fabrikant.env wird nur beim Start geladen → Token würde stale werden).
# Stattdessen: scripts/gh-token-refresh.py (Cron */30) schreibt es in
# FABRIKANT_ENV_FILE (Default ~/.config/fabrikant/fabrikant.env), das pro API-Call neu gelesen wird.
#   BUILDER_APP_ID=<Client-ID (Iv23…, empfohlen) oder App-ID>
#   BUILDER_APP_KEY_FILE=/pfad/zu/app-private-key.pem
#   BUILDER_INSTALLATION_ID=<Installation-ID>
# Reviewer als zweite App statt PAT (z. B. my-reviewer-app): Token per
# `scripts/gh-token-refresh.py --role reviewer` (Cron */30) → GITHUB_REVIEWER_TOKEN.
#   REVIEWER_APP_ID=<Client-ID oder App-ID>
#   REVIEWER_APP_KEY_FILE=/pfad/zu/qa-app-private-key.pem
#   REVIEWER_INSTALLATION_ID=<Installation-ID>
# GITHUB_REVIEWER_TOKEN: Installation-Token der Reviewer-App (1h gültig).
# App braucht: Contents:read + Pull requests:read/write am Ziel-Repo.
# GITHUB_REVIEWER_TOKEN=

# Agent-Backend (P1): opencode serve als Worker-Backend (1.x und 2.x,
# Version wird automatisch erkannt — ADR 0005)
#   opencode serve --hostname 127.0.0.1   (Default-Port 4096)
#   Model-Format: provider/model — Provider-Name wie in der opencode-Config
#   (~/.config/opencode/opencode.jsonc), z.B. llama/Qwen3.8-27B-GGUF
FABRIKANT_AGENT_BACKEND=opencode
FABRIKANT_AGENT_ENDPOINT=http://127.0.0.1:4096
FABRIKANT_AGENT_MODEL=llama/Qwen3.8-27B-GGUF
# Session-Inaktivitaets-Schwelle (s): CPU-Boxen brauchen mehr (Prompt-Processing
# fuer das erste Token), GPU-Servers koennen kuerzer. Default 900.
# FABRIKANT_AGENT_STALE_AFTER=900
# opencode 2.x: HTTP-Basic-Auth am serve-Prozess (gleicher Wert wie
# OPENCODE_SERVER_PASSWORD beim Server-Start; 1.x braucht kein Passwort).
# FABRIKANT_AGENT_PASSWORD=
# FABRIKANT_AGENT_USERNAME=opencode
#
# Agent-Backend 'copilot' (GitHub Copilot CLI, One-Shot `copilot -p`):
#   FABRIKANT_AGENT_BACKEND=copilot
#   Model optional (CLI-Default), z.B. FABRIKANT_AGENT_MODEL=gpt-5.3-codex
#   Tools-Override (Default --allow-all-tools): FABRIKANT_COPILOT_TOOLS=shell,write
#   Auth: COPILOT_GITHUB_TOKEN / GH_TOKEN / GITHUB_TOKEN (fine-grained PAT,
#   "Copilot Requests") — in der Deployment-Umgebung setzen, nicht hier committen.
# FABRIKANT_COPILOT_TOOLS=
#
# Agent-Env-Allowlist (ADR 0050): Agent-Prozesse erben kein os.environ.
# Zusätzliche (nicht sensible) Env-Namen, die Agent-Prozesse erhalten (kommagetrennt):
# FABRIKANT_AGENT_ENV_EXTRA=
#
# Egress default-deny (ADR 0051): Agent-Internetzugang nur über den Allowlist-Proxy.
# `fabrikant egress start|stop|status`. Port/Proxy-Image/erlaubte Domänen:
# FABRIKANT_EGRESS_PORT=8899
# FABRIKANT_EGRESS_IMAGE=            # Default: vimagick/tinyproxy per Digest gepinnt (tinyproxy 1.11.0)
# FABRIKANT_EGRESS_ALLOWLIST=example.org      # kommasetrennt, ergänzt die Datei + Builtins
# FABRIKANT_EGRESS_ALLOWLIST_FILE=deploy/egress-allowlist.txt   # optional, keine Voreinstellung; Einträge werden validiert
# Gepinnte Subnets der Proxy-Netzwerke (die gerenderten Allow-Zeilen nutzen genau diese Werte)
# FABRIKANT_EGRESS_SUBNET=172.27.0.0/16
# FABRIKANT_SANDBOX_SUBNET=172.28.0.0/16
#
# Per-Run-Agent-Sandbox (ADR 0054, in Überarbeitung): Jeder One-Shot-CLI-Agent-Run im Docker-Container
# (cap-drop ALL, no-new-privileges, Resource-Caps, read-only root fs, kein Worktree-Mount:
# Austausch per git-Bundle). Das Image braucht die Agent-CLI und git.
# FABRIKANT_SANDBOX=0
# FABRIKANT_SANDBOX_IMAGE=fabrikant/agent-sandbox:latest
# FABRIKANT_SANDBOX_MEMORY=4g
# FABRIKANT_SANDBOX_CPUS=2
# FABRIKANT_SANDBOX_PIDS_LIMIT=512
# FABRIKANT_SANDBOX_USER=                       # leer = host uid:gid (als root: 10001:10001)
# FABRIKANT_SANDBOX_NETWORK=fabrikant-sandbox      # ADR 0051: internal, kein direkter Egress
# FABRIKANT_SANDBOX_WORK_SIZE=2g                # tmpfs für den Arbeitsklon (zählt gegen MEMORY)
# FABRIKANT_EGRESS_PROXY_URL=                   # Default: http://fabrikant-egress-proxy:8888 (von `fabrikant egress start`)

# Dead-Man's-Switch: Runs in 'running' älter als Xh → error + Alert
# FABRIKANT_STALE_HOURS=6

# Run-Store (ADR 0034; README „Run-Store“): sql (Default) | json. Bestand: `fabrikant migrate-runs`.
# FABRIKANT_RUN_STORE=sql
# SQL-Store: SQLAlchemy-URL; Default sqlite:///<FABRIKANT_HOME>/state/fabrikant.db
# FABRIKANT_DB_URL=

# Worker-Pool: max. parallele Runs (Trigger). Lokal/Initial-Test: 1 → alle
# Runs seriell auf einem einzigen Agent-Worker (keine parallelen LLM-Sessions).
# FABRIKANT_WORKERS=1
# Sprache der Server-Meldungen (Run-Log, Approval-Kontext): de (Default) | en
# FABRIKANT_LANG=de

# Spec-Quellen (ADR 0047; README „Spec-Quellen“). FABRIKANT_PROJECTS_PATH: zusätzliche Spec-Ordner
# bzw. Repos mit .fabrikant/fabrikant.yaml, doppelpunkt-getrennt. FABRIKANT_DATA: eigene Specs/Templates
# unter $FABRIKANT_DATA/projects|templates (Default: FABRIKANT_HOME).
# FABRIKANT_PROJECTS_PATH=/srv/fabrikant/projects:/home/me/src/app

# Run-Worktrees (ADR 0028, Ort: ADR 0047 Nachtrag). Default
# $XDG_STATE_HOME/fabrikant/worktrees/<installation> (~/.local/state/…) — außerhalb des
# Checkouts, damit IDEs/Indexer sie nicht sehen. Bei flüchtigem $HOME auf ein Volume legen.
# FABRIKANT_WORKTREES=/srv/fabrikant/worktrees

# SonarQube (Loop `sonar-scan`, scripts/sonar-scan.sh): Admin-Credentials für
# Readiness-Check + Token-Generierung (nur relevant, wenn noch kein Token
# gecacht ist). Token wird gecacht in state/sonar-token.txt.
# SONAR_HOST_URL=http://127.0.0.1:9000
# SONAR_ADMIN_USER=admin
# SONAR_ADMIN_PASSWORD=
# SONAR_TOKEN_FILE=
# Branch-/PR-Analyse + GitHub-PR-Dekoration (docs/sonarqube.md):
# SONAR_BRANCH=auto
# SONAR_PR=auto
# SONAR_GH_APP_ID=
# SONAR_GH_CLIENT_ID=
# SONAR_GH_CLIENT_SECRET=
# SONAR_GH_PRIVATE_KEY=state/sonar-github-app.pem

# Auth (ADR 0030): none (Default, nur Loopback) | local (Benutzer + Rollen: `fabrikant user add`)
# FABRIKANT_AUTH=local
# FABRIKANT_SESSION_TTL=28800
# FABRIKANT_COOKIE_SECURE=1   # hinter TLS-Reverse-Proxy
# FABRIKANT_HOST=127.0.0.1
# OIDC (ADR 0046; `pip install 'fabrikant[oidc]'`): FABRIKANT_AUTH=oidc
# FABRIKANT_OIDC_ISSUER=https://idp.example.com/realms/fabrikant
# FABRIKANT_OIDC_CLIENT_ID=fabrikant
# FABRIKANT_OIDC_CLIENT_SECRET=
# FABRIKANT_OIDC_REDIRECT_URI=https://fabrikant.example.com/api/oidc/callback
# FABRIKANT_OIDC_ROLE_MAP=fabrikant-admins=admin,fabrikant-ops=operator,fabrikant-view=viewer
# FABRIKANT_OIDC_GROUPS_CLAIM=groups   # Cognito: cognito:groups
# FABRIKANT_OIDC_SCOPES="openid profile email"

