# Every 30 min — the installation token lives 1h (2x buffer).
# RandomizedDelaySec: DNS/network flakes do not hit in sync with other timers.

[Unit]
Description=Fabrikant — gh-token-refresh (reviewer) every 30 min

[Timer]
OnBootSec=1min
OnUnitActiveSec=30min
RandomizedDelaySec=2min
AccuracySec=1min

[Install]
WantedBy=timers.target
