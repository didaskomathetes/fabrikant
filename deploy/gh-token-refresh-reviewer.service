# gh-token-refresh (reviewer) — GitHub-App-Installation-Token für fabrik erneuern (ADR 0010).
#
# Mintet alle 30 min ein frisches 1h-Installation-Token für die
# fabrik-reviewer-App (--role reviewer) und schreibt es nach $FABRIK_ENV_FILE
# (state/github.env). fabrik liest die Datei pro API-Call neu — kein Restart.
#
# Install:
#   cp fabrik/deploy/gh-token-refresh-reviewer.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now gh-token-refresh-reviewer.timer
#
# Status/Logs:
#   systemctl --user status gh-token-refresh-reviewer.timer
#   journalctl --user -u gh-token-refresh-reviewer.service -f
#
# Config (REVIEWER_APP_ID, REVIEWER_APP_KEY_FILE, REVIEWER_INSTALLATION_ID) kommt
# aus fabrik/fabrik.env — das Script lädt es selbst als Fallback.
#
# Pfad: FABRIK_HOME (= fabrik/-Verzeichnis des Checkouts) kommt aus
# ~/.config/fabrik/deploy.env — siehe fabrik/README.md, „Lokaler Betrieb".

[Unit]
Description=Fabrik — GitHub-App-Installation-Token refresh (fabrik-reviewer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/fabrik/deploy.env
ExecStart=/bin/sh -c 'cd "$${FABRIK_HOME:?FABRIK_HOME fehlt, siehe ~/.config/fabrik/deploy.env}" && exec .venv/bin/python scripts/gh-token-refresh.py --role reviewer'
