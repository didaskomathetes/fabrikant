# fabrikant-autoupdate — main nachziehen + fabrikant.service nach Merges neu starten.
#
# ff-only-Pull von origin/main im Haupt-Checkout, bei Änderungen unter fabrikant/
# Neustart von fabrikant.service — aber nur im Leerlauf (kein running/queued Run);
# sonst vertagt auf den nächsten Timer-Tick.
#
# Install (setzt fabrikant.service voraus):
#   cp fabrikant/deploy/fabrikant-autoupdate.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now fabrikant-autoupdate.timer
#
# Status/Logs:
#   systemctl --user status fabrikant-autoupdate.timer
#   journalctl --user -u fabrikant-autoupdate.service -f
#
# Pfad: FABRIKANT_HOME (= fabrikant/-Verzeichnis des Checkouts) kommt aus
# ~/.config/fabrikant/deploy.env — siehe fabrikant/README.md, „Lokaler Betrieb".

[Unit]
Description=Fabrikant — main nachziehen und fabrikant.service nach Merges neu starten
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/fabrikant/deploy.env
# uv für `uv sync` bei geänderten Abhängigkeiten
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh -c 'cd "$${FABRIKANT_HOME:?FABRIKANT_HOME fehlt, siehe ~/.config/fabrikant/deploy.env}" && exec .venv/bin/python scripts/fabrikant-autoupdate.py'
