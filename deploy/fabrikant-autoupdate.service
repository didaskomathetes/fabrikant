# fabrikant-autoupdate — pull main + restart fabrikant.service after merges.
#
# ff-only pull of origin/main in the main checkout; on changes under fabrikant/
# restart fabrikant.service — but only when idle (no running/queued run);
# otherwise deferred to the next timer tick.
#
# Install (setzt fabrikant.service voraus):
#   cp deploy/fabrikant-autoupdate.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now fabrikant-autoupdate.timer
#
# Status/Logs:
#   systemctl --user status fabrikant-autoupdate.timer
#   journalctl --user -u fabrikant-autoupdate.service -f
#
# Path: FABRIKANT_HOME (= the fabrikant/ directory of the checkout) comes from
# ~/.config/fabrikant/deploy.env — see docs/operations.md, "Local operation".

[Unit]
Description=Fabrikant — pull main and restart fabrikant.service after merges
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/fabrikant/deploy.env
# uv for `uv sync` when dependencies change
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh -c 'cd "$${FABRIKANT_HOME:?FABRIKANT_HOME missing, see ~/.config/fabrikant/deploy.env}" && exec .venv/bin/python scripts/fabrikant-autoupdate.py'
