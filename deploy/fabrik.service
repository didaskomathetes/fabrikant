# Fabrik — Software-Fabrik (Engine + UI + Scheduler) als systemd-User-Service.
#
# Ohne diesen Service lebt der Scheduler NUR im `fabrik serve`-Prozess —
# Terminal zu / Reboot → keine cron-Trigger mehr (Regression: review-pr
# 2026-10-18, cron lief nicht, weil der Foreground-Prozess gestorben war).
#
# Install:
#   cp fabrik/deploy/fabrik.service ~/.config/systemd/user/fabrik.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now fabrik
#
# Status/Logs:
#   systemctl --user status fabrik
#   journalctl --user -u fabrik -f
#
# Auto-Update nach Merges: fabrik-autoupdate.{service,timer}.
# ExecStartPre merkt sich den gestarteten Commit (state/serve-commit), daran
# erkennt scripts/fabrik-autoupdate.py, ob ein Neustart fällig ist.
#
# Alle Secrets kommen aus fabrik/fabrik.env (wird von config.py geladen) —
# keine Shell-Env-Variablen nötig.
#
# Pfad: FABRIK_HOME (= fabrik/-Verzeichnis des Checkouts) kommt aus
# ~/.config/fabrik/deploy.env — siehe fabrik/README.md, „Lokaler Betrieb".

[Unit]
Description=Fabrik — Software-Fabrik (Engine + UI + Scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/fabrik/deploy.env
ExecStartPre=/bin/sh -c 'cd "$${FABRIK_HOME:?FABRIK_HOME fehlt, siehe ~/.config/fabrik/deploy.env}" && mkdir -p state && git rev-parse HEAD > state/serve-commit'
ExecStart=/bin/sh -c 'cd "$${FABRIK_HOME:?FABRIK_HOME fehlt, siehe ~/.config/fabrik/deploy.env}" && exec .venv/bin/fabrik serve'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
