# Fabrikant — software factory (engine + UI + scheduler) as a systemd user service.
#
# Without this service the scheduler lives ONLY in the `fabrikant serve` process —
# terminal closed / reboot → no more cron triggers (regression: review-pr
# 2026-10-18, cron did not run because the foreground process had died).
#
# Install:
#   cp deploy/fabrikant.service ~/.config/systemd/user/fabrikant.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now fabrikant
#
# Status/Logs:
#   systemctl --user status fabrikant
#   journalctl --user -u fabrikant -f
#
# Auto-update after merges: fabrikant-autoupdate.{service,timer}.
# ExecStartPre records the started commit (state/serve-commit), which
# scripts/fabrikant-autoupdate.py uses to detect whether a restart is due.
#
# All secrets come from fabrikant/fabrikant.env (loaded by config.py) —
# no shell env variables needed.
#
# Path: FABRIKANT_HOME (= the fabrikant/ directory of the checkout) comes from
# ~/.config/fabrikant/deploy.env — see docs/operations.md, "Local operation".

[Unit]
Description=Fabrikant — software factory (engine + UI + scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/fabrikant/deploy.env
ExecStartPre=/bin/sh -c 'cd "$${FABRIKANT_HOME:?FABRIKANT_HOME missing, see ~/.config/fabrikant/deploy.env}" && mkdir -p state && git rev-parse HEAD > state/serve-commit'
ExecStart=/bin/sh -c 'cd "$${FABRIKANT_HOME:?FABRIKANT_HOME missing, see ~/.config/fabrikant/deploy.env}" && exec .venv/bin/fabrikant serve'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
